# Auto detect text files and perform LF normalization
* text=auto

# Source files
*.php text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Exclude from export
/.gitattributes export-ignore
/.gitignore export-ignore
/.phpunit.cache export-ignore
/phpunit.xml export-ignore
/tests export-ignore
