# Auto detect text files and perform LF normalization
* text=auto

# Source files
*.php text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Exclude from export (Composer dist archives)
/.gitattributes export-ignore
/.gitignore export-ignore
/.github export-ignore
/.phpunit.cache export-ignore
/phpunit.xml export-ignore
/tests export-ignore
/EXAMPLES.md export-ignore
/PACKAGE_STRUCTURE.md export-ignore
/CODE_OF_CONDUCT.md export-ignore
/CONTRIBUTING.md export-ignore
