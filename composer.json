{
    "name": "martin-lechene/laravel-bytez",
    "description": "Unofficial Laravel package for the Bytez API - a unified interface for 175k+ AI models",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "bytez",
        "ai",
        "ml",
        "machine-learning",
        "chat",
        "image",
        "video",
        "audio"
    ],
    "homepage": "https://github.com/martin-lechene/bytez-laravel",
    "authors": [
        {
            "name": "Martin Lechene",
            "email": "contact@doganddev.eu"
        }
    ],
    "support": {
        "issues": "https://github.com/martin-lechene/bytez-laravel/issues",
        "source": "https://github.com/martin-lechene/bytez-laravel",
        "email": "contact@doganddev.eu",
        "docs": "https://github.com/martin-lechene/bytez-laravel#readme"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/cache": "^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Bytez\\LaravelBytez\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bytez\\LaravelBytez\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bytez\\LaravelBytez\\BytezServiceProvider"
            ],
            "aliases": {
                "Bytez": "Bytez\\LaravelBytez\\Facades\\Bytez"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "test:unit": "phpunit --testsuite=Unit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
